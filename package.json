{
  "name": "entropy-mnemonic",
  "version": "1.3.0",
  "type": "module",
  "description": "A complete BIP-39 mnemonic and entropy generator with seed generation, validation, and multi-language support in TypeScript.",
  "main": "es/index.js",
  "module": "es/index.js",
  "browser": "umd/index.js",
  "scripts": {
    "build": "rollup -c",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest",
    "prepublishOnly": "npm run build",
    "coverage": "vitest run --coverage",
    "release": "standard-version"
  },
  "files": [
    "es/",
    "umd/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xeondesk/entropy-mnemonic"
  },
  "keywords": [
    "entropy-mnemonic",
    "mnemonic",
    "passphrase",
    "entropy",
    "bip39",
    "seed",
    "cryptocurrency",
    "wallet",
    "bip-39",
    "validation"
  ],
  "funding": "https://github.com/sponsors/xeondesk",
  "author": "Md Sulaiman <infosulaiman@icloud.com>",
  "private": false,
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xeondesk/entropy-mnemonic/issues"
  },
  "homepage": "https://github.com/xeondesk/entropy-mnemonic#readme",
  "devDependencies": {
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@vitest/coverage-v8": "^5.0.3",
    "c8": "^9.1.0",
    "eslint": "^8.24.0",
    "prettier": "^3.0.0",
    "rollup": "^3.10.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "js-sha256": "^0.9.0",
    "pbkdf2": "^3.0.17",
    "tslib": "^2.6.0"
  }
}
